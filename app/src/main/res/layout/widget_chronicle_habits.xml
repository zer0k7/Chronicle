<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="horizontal"
    android:padding="16dp"
    android:baselineAligned="false">

    <!-- Card 1: Pickups & Unlocks -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_inner_surface"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center"
        android:layout_marginEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_device_unlocks"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/tv_widget_habits_unlocks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0"
            android:textColor="@color/widget_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_habits_pickup_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Every 15m"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Card 2: Ghost Opens & Bedtime -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_inner_surface"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center"
        android:layout_marginStart="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_ghost_reflex"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/tv_widget_habits_ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0"
            android:textColor="@color/widget_secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_habits_ghost_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_label_ghost_sub"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
