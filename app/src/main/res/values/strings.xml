    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Chronicle</string>
    <string name="onboarding_welcome_desc">Chronicle visualizes your digital habits through an elegant, wallpaper-inspired timeline. All data remains strictly private on your device.</string>
